{
  "name": "Fifth-Lesson",
  "version": "1.0.0",
  "description": "Genius Courses Fullstack NodeJS - TS + Express & MongoDB + authentication & authorization + multer",
  "main": "server.ts",
  "author": "PgkSoft",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "mongodb": "^7.0.0",
    "mongoose": "^8.17.2",
    "multer": "^2.0.2",
    "pino": "^10.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "8"
  },
  "scripts": {
    "dev": "ts-node-dev --require tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "cross-env TSX_TSCONFIG=tsconfig.test.json mocha --require tsx --file tests/setup.ts tests/**/*.spec.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "prune": "ts-prune",
    "knip": "knip",
    "migrate:status": "ts-node -r tsconfig-paths/register storage-migrations/migrate.ts status",
    "migrate:up": "ts-node -r tsconfig-paths/register storage-migrations/migrate.ts up",
    "migrate:up:limit": "ts-node -r tsconfig-paths/register storage-migrations/migrate.ts up --limit=1",
    "migrate:down": "ts-node -r tsconfig-paths/register storage-migrations/migrate.ts down",
    "migrate:rollback": "ts-node -r tsconfig-paths/register storage-migrations/migrate.ts down-last"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/express": "^5.0.3",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "8",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "chai": "^6.0.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "knip": "^5.81.0",
    "mocha": "^11.7.2",
    "mongodb-memory-server": "^10.2.1",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "ts-prune": "^0.10.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
