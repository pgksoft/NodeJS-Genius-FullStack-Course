{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@domain/*": [
                "src/domain/*"
            ],
            "@api/*": [
                "src/app-infrastructure/api/*"
            ],
            "@helpers/*": [
                "src/app-infrastructure/app-helpers/*"
            ],
            "@middleware/*": [
                "src/app-infrastructure/middleware/*"
            ],
            "@infra/*": [
                "src/app-infrastructure/*"
            ],
            "@db/*": [
                "src/db/*"
            ],
            "@src/*": [
                "src/*"
            ],
        }
    },
    "include": [
        "src",
        "tests"
    ],
    "exclude": [
        "dist",
        "dist-tests",
        "node_modules"
    ]
}